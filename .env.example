# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=stscdfdata;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_RAW=raw
AZURE_STORAGE_CONTAINER_PROCESSED=processed

# Azure ML Workspace
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-scdf-dev
AZURE_ML_WORKSPACE_NAME=aml-scdf

# Azure Service Principal (for programmatic access / CI)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=

# Azure Container Registry
AZURE_CONTAINER_REGISTRY=acrscdf.azurecr.io
